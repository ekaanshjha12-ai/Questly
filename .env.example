# Copy this file to `.env` for local use. `.env` is gitignored.
# In production these are set in your host's dashboard instead — see DEPLOY.md.

# Enables the photo / voice quest verification agent.
# Get a key at https://console.anthropic.com/settings/keys
# Without it, verification shows a clear "not switched on" message.
ANTHROPIC_API_KEY=

# Verification checks allowed per person per day. Defaults to 10 when unset.
# Each one is a paid vision call on the key above. Set 0 to disable entirely.
VERIFY_DAILY_LIMIT=

# When set, signup requires this code. Leave blank to allow open registration.
INVITE_CODE=

# Where the SQLite file lives. Defaults to server/data.
# Point this at your host's mounted volume if it is somewhere else.
DATA_DIR=
